# TMP11X_RS temperature sensor configuration options

# SPDX-License-Identifier: Apache-2.0

config TMP11X_RS
    bool "TMP116, TMP117 and TMP119 Temperature Sensors Rust"
    default y
    depends on DT_HAS_TI_TMP11X_RS_ENABLED
    select I2C
    select LOG
    select RUST
    select RUST_ALLOC
    help
      Enable driver for TMP116, TMP117 and TMP119 temperature sensors.

if TMP11X_RS

module = TMP11X_RS
thread_priority = 10
thread_stack_size = 1024

endif